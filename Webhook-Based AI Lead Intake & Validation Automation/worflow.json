    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"name\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"email\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"company\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"phone\": {\n      \"type\": [\"string\", \"number\", \"null\"]\n    },\n    \"products\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"pName\": {\n            \"type\": [\"string\", \"null\"]\n          },\n          \"pQuantity\": {\n            \"type\": [\"number\", \"null\"]\n          }\n        },\n        \"required\": [\"pName\", \"pQuantity\"]\n      }\n    },\n    \"budget\": {\n      \"type\": [\"number\", \"null\"]\n    }\n  },\n  \"required\": [\n    \"name\",\n    \"email\",\n    \"company\",\n    \"phone\",\n    \"products\",\n    \"budget\"\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        -680,
        328
      ],
      "id": "d6b6071d-bc25-402f-ae28-14c0fc3904ea",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json.output;\n\nconst errors = [];\n\n// -------------------------\n// NAME\n// -------------------------\nif (!data.name || !String(data.name).trim()) {\n  errors.push(\"Name is required.\");\n}\n\n// -------------------------\n// EMAIL\n// -------------------------\nif (!data.email || !String(data.email).trim()) {\n  errors.push(\"Email is required.\");\n} else {\n  const email = String(data.email).trim();\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\n  if (!emailRegex.test(email)) {\n    errors.push(\"Please provide a valid email address.\");\n  }\n}\n\n// -------------------------\n// PHONE\n// -------------------------\nif (!data.phone || !String(data.phone).trim()) {\n  errors.push(\"Phone number is required.\");\n} else {\n  // Remove spaces, brackets and hyphens\n  const phone = String(data.phone).replace(/[\\s()-]/g, \"\");\n\n  // Allows optional + followed by 7-15 digits\n  const phoneRegex = /^\\+?\\d{7,15}$/;\n\n  if (!phoneRegex.test(phone)) {\n    errors.push(\"Please provide a valid phone number.\");\n  }\n}\n\n// -------------------------\n// COMPANY\n// -------------------------\nif (!data.company || !String(data.company).trim()) {\n  errors.push(\"Company name is required.\");\n}\n\n// -------------------------\n// PRODUCTS\n// -------------------------\nif (!Array.isArray(data.products) || data.products.length === 0) {\n  errors.push(\"At least one product is required.\");\n} else {\n  data.products.forEach((product, index) => {\n\n    if (!product.pName || !String(product.pName).trim()) {\n      errors.push(`Product ${index + 1}: Product name is required.`);\n    }\n\n    if (\n      product.pQuantity === null ||\n      product.pQuantity === undefined ||\n      Number(product.pQuantity) <= 0\n    ) {\n      errors.push(`Product ${index + 1}: Valid quantity is required.`);\n    }\n  });\n}\n\n// -------------------------\n// BUDGET\n// -------------------------\nif (\n  data.budget === null ||\n  data.budget === undefined ||\n  data.budget === \"\"\n) {\n  errors.push(\"Budget is required.\");\n} else if (\n  isNaN(Number(data.budget)) ||\n  Number(data.budget) <= 0\n) {\n  errors.push(\"Budget must be a valid amount greater than 0.\");\n}\n\n// -------------------------\n// COUNTRY\n// -------------------------\n\n// -------------------------\n// FINAL RESULT\n// -------------------------\nreturn [{\n  json: {\n    ...data,\n    isValid: errors.length === 0,\n    status: errors.length === 0\n      ? \"Valid\"\n      : \"Missing or Invalid Information\",\n    errors\n  }\n}];"
      },
