        "text": "=Extract product and quantity from \n {{ $json.body.Requirements }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=Extract the customer enquiry from the Google Form data according to the provided output schema.\n\nRules:\n- Extract only information provided in the form.\n- Do not invent or assume information.\n- If any value is missing or empty, return actual JSON null, never the string \"null\".\n- Extract each product from the requirement separately with its corresponding pName and pQuantity.\n- If quantity is not provided, use null.\n- Follow the output schema exactly.\n\nForm data:\n{{ JSON.stringify($json.body) }}"
        }
      },
