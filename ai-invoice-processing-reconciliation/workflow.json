      "parameters": {
        "jsCode": "\nconst invoice = $('Information Extractor').first().json.output;\nconst po = $input.first().json;\n\n// Normalize product and supplier names\nconst normalize = (value) =>\n  String(value ?? \"\")\n    .toLowerCase()\n    .replace(/&/g, \" and \")\n    .replace(/[^a-z0-9]/g, \"\");\n\n// Convert monetary values\nconst amount = (value) => {\n  if (value === null || value === undefined || value === \"\") {\n    return null;\n  }\n\n  const num = Number(value);\n  return Number.isFinite(num) ? num : null;\n};\n\n// Compare numeric values to 2 decimal places\nconst sameAmount = (a, b) => {\n  const x = amount(a);\n  const y = amount(b);\n\n  return x !== null &&\n    y !== null &&\n    Math.abs(x - y) < 0.01;\n};\n\n// Check if PO exists\nif (!po.id) {\n  return [{\n    json: {\n      status: \"PO Not Found\",\n      allMatch: false,\n      message: \"No matching purchase order found.\"\n    }\n  }];\n}\n\n// Supplier and currency validation\nconst supplierMatch = normalize(invoice.companyName) !== \"\" &&\n  normalize(invoice.companyName) === normalize(po.company_name);\n\n\n// Compare invoice products against PO products\nconst invoiceItems = invoice.items ?? [];\nconst poItems = Array.isArray(po.items) ? po.items : [];\n\nconst usedPoIndexes = new Set();\nconst itemResults = [];\n\nfor (const item of invoiceItems) {\n\n  const matchIndex = poItems.findIndex((p, index) =>\n    !usedPoIndexes.has(index) &&\n    normalize(p.productName) !== \"\" &&\n    normalize(p.productName) === normalize(item.productName)\n  );\n\n  if (matchIndex === -1) {\n    itemResults.push({\n      productName: item.productName,\n      status: \"Product Not Found\",\n      matched: false\n    });\n    continue;\n  }\n\n  usedPoIndexes.add(matchIndex);\n\n  const poItem = poItems[matchIndex];\n\n  const quantityMatch = sameAmount(\n    item.quantity,\n    poItem.quantity\n  );\n\n  const unitMatch = normalize(item.unit) !== \"\" &&\n    normalize(item.unit) === normalize(poItem.unit);\n\n  const unitPriceMatch = sameAmount(\n    item.unitPrice,\n    poItem.unitPrice\n  );\n\n  const totalPriceMatch = sameAmount(\n    item.totalPrice,\n    poItem.totalPrice\n  );\n\n  const matched =\n    quantityMatch &&\n    unitMatch &&\n    unitPriceMatch &&\n    totalPriceMatch;\n\n  itemResults.push({\n    productName: item.productName,\n    poProductName: poItem.productName,\n    quantityMatch,\n    unitMatch,\n    unitPriceMatch,\n    totalPriceMatch,\n    matched,\n    status: matched ? \"Matched\" : \"Mismatch\",\n    invoiceValues: item,\n    poValues: poItem\n  });\n}\n\n// PO products not represented in the invoice\nconst unmatchedPoItems = poItems\n  .filter((_, index) => !usedPoIndexes.has(index))\n  .map(p => p.productName);\n\n// Compare invoice totals\nconst subtotalMatch = sameAmount(\n  invoice.subtotal,\n  po.subtotal\n);\n\nconst gstMatch = sameAmount(\n  invoice.gst,\n  po.gst\n);\n\nconst grandTotalMatch = sameAmount(\n  invoice.grandTotal,\n  po.grand_total\n);\n\nconst itemsMatch =\n  itemResults.length > 0 &&\n  itemResults.every(item => item.matched) &&\n  unmatchedPoItems.length === 0;\n\n// Final validation\nconst allMatch =\n  supplierMatch &&\n  itemsMatch &&\n  subtotalMatch &&\n  gstMatch &&\n  grandTotalMatch;\n\nreturn [{\n  json: {\n    status: allMatch ? \"Matched\" : \"Mismatch\",\n    allMatch,\n    supplierMatch,\n    itemsMatch,\n    subtotalMatch,\n    gstMatch,\n    grandTotalMatch,\n    itemResults,\n    unmatchedPoItems,\n    differences: {\n      subtotal: {\n        invoice: invoice.subtotal,\n        supabase: po.subtotal\n      },\n      gst: {\n        invoice: invoice.gst,\n        supabase: po.gst\n      },\n      grandTotal: {\n        invoice: invoice.grandTotal,\n        supabase: po.grand_total\n      }\n    }\n  }\n}];\n"
      },
